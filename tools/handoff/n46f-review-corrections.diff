new file mode 100644
index 0000000000000000000000000000000000000000..9e8fe0325f6b294f16e8c372ceecfb7140e5dbfe
--- /dev/null
+++ b/.ci/validate_cjk_report.py
@@ -0,0 +1,26 @@
+"""CJK evidence gate; compare identities as well as reported totals."""
+from test_cjk_recall import status_counts
+
+EXPECTED_CHECKS = frozenset(['memory_single_char', 'memory_double_char', 'memory_mixed_ascii', 'memory_noncontiguous_miss', 'mcp_memory_read_hit', 'search_phrase_hits', 'search_single_char_hits', 'search_ext_block_hits', 'search_kana_hits', 'search_hangul_hits', 'append_beside_fts', 'dedupe_by_page', 'mcp_put_alpha_ok', 'source_filter_alpha', 'source_denied', 'like_special_literal', 'sql_style_literal', 'db_alive_after_sql', 'title_match', 'slug_match', 'ascii_fts_still_works', 'ascii_no_supplement_noise', 'stable_order', 'search_limit', 'memory_limit_and_bytes', 'update_visible', 'update_old_gone', 'soft_delete_excluded', 'hard_delete_excluded', 'memory_forget', 'read_does_not_write'])
+
+
+def validate_report(report: dict, *, source_commit: str, binary_sha256: str,
+                    script_sha256: str) -> None:
+    checks = report.get("checks")
+    if not isinstance(checks, list) or not checks:
+        raise ValueError("Missing CJK checks")
+    names = [item.get("name") for item in checks]
+    if len(names) != len(set(names)) or set(names) != EXPECTED_CHECKS:
+        raise ValueError("Incomplete or duplicated CJK checks")
+    counts = status_counts(checks)
+    if (report.get("result") != "PASS" or counts["fail"] != 0 or
+            report.get("check_count") != counts["total"] or report.get("counts") != counts):
+        raise ValueError("CJK result/count mismatch")
+    for key, expected in (("source_commit", source_commit), ("binary_sha256", binary_sha256),
+                          ("script_sha256", script_sha256)):
+        if not expected or report.get(key) != expected:
+            raise ValueError("CJK provenance mismatch: " + key)
+    commands = report.get("commands")
+    if not isinstance(commands, list) or not commands or any(
+            type(item.get("exit_code")) is not int or item["exit_code"] != 0 for item in commands):
+        raise ValueError("CJK command evidence missing or failed")
